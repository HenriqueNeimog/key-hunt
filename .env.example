KEY_HUNT_ENVIRONMENT=development
KEY_HUNT_DATABASE_URL=sqlite:///./key_hunt.db
KEY_HUNT_MEDIA_DIR=./media
KEY_HUNT_SECRET_KEY=change-me-with-at-least-32-random-characters
KEY_HUNT_PLAYLIST_CACHE_TTL_SECONDS=3600
KEY_HUNT_MAX_PLAYLIST_ITEMS=100
KEY_HUNT_MAX_TRACK_DURATION_SECONDS=1800
KEY_HUNT_MAX_AUDIO_BYTES=104857600
KEY_HUNT_DOWNLOAD_TIMEOUT_SECONDS=300
KEY_HUNT_METADATA_TIMEOUT_SECONDS=60
KEY_HUNT_MAX_CONCURRENT_JOBS=2
KEY_HUNT_ANALYSIS_VERSION=essentia-keyextractor-v1
KEY_HUNT_LOW_CONFIDENCE_THRESHOLD=0.35
KEY_HUNT_FFMPEG_BINARY=ffmpeg
KEY_HUNT_PROCESSING_MODE=inline
KEY_HUNT_PREFETCH_WINDOW_SIZE=3
KEY_HUNT_MEDIA_WORKER_CONCURRENCY=2
KEY_HUNT_MEDIA_MAX_ATTEMPTS=5
KEY_HUNT_MEDIA_JOB_TIMEOUT_SECONDS=600
KEY_HUNT_MEDIA_CLAIM_LEASE_SECONDS=900
KEY_HUNT_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KEY_HUNT_KAFKA_CONSUMER_GROUP=key-hunt-media-workers
KEY_HUNT_KAFKA_PREPARE_TOPIC=key-hunt.media.prepare.v1
KEY_HUNT_KAFKA_RETRY_TOPIC=key-hunt.media.prepare.retry.v1
KEY_HUNT_KAFKA_DLQ_TOPIC=key-hunt.media.prepare.dlq.v1
KEY_HUNT_OUTBOX_POLL_INTERVAL_SECONDS=0.5
KEY_HUNT_OUTBOX_BATCH_SIZE=20
KEY_HUNT_OUTBOX_CLAIM_TIMEOUT_SECONDS=60
